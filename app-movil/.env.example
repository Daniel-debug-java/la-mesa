# Copia este archivo como .env y pega las credenciales del proyecto.
# Las variables con prefijo EXPO_PUBLIC_ quedan disponibles en la app.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sede de arranque: El Poblado, Medellín
EXPO_PUBLIC_SEDE_ID=11111111-1111-1111-1111-111111111111

# Wompi: llave pública de comercio. La privada NUNCA va en la app,
# vive en una función de servidor que firma la transacción.
EXPO_PUBLIC_WOMPI_LLAVE_PUBLICA=pub_prod_xxxxxxxx
EXPO_PUBLIC_WOMPI_REDIRECCION=lamesa://pago
